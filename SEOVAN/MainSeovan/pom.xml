        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-dialogs</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>beleris.es</groupId>
            <artifactId>FinalDBManager</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>beleris.es</groupId>
            <artifactId>FinalInformationManager</artifactId>
            <version>1.0-SNAPSHOT</version>
